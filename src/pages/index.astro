---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
import Pillars from '../components/Pillars.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { CATEGORIES } from '../consts';

const carnets = (await getCollection('carnets')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);

// L'article fondateur est retiré du flux chronologique et affiché en haut
const fondation = carnets.find((e) => e.id === 'planter-tailler-vendanger');
const autres = carnets.filter((e) => e.id !== 'planter-tailler-vendanger');
---
<BaseLayout>
  <div class="wrap">
    <Header />
  </div>

  <div class="wrap">
    <Hero />
    <Pillars />

    {/* Article fondateur — hors du flux chronologique */}
    {fondation && (
      <section class="fondation reveal">
        <div class="fondation-badge">Article fondateur</div>
        <a class={`entry tag-${fondation.data.category} fondation-card`} href={`/carnets/${fondation.id}/`}>
          <div class="entry-meta">
            <span>{CATEGORIES[fondation.data.category].label}</span>
            <span>·</span>
            <span>{fondation.data.date.toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' })}</span>
            <span>·</span>
            <span>{Math.max(1, Math.ceil((fondation.body?.split(/\s+/).length ?? 0) / 200))} min</span>
          </div>
          <h3 class="entry-title">{fondation.data.title}</h3>
          {fondation.data.teaser && <p class="entry-teaser">{fondation.data.teaser}</p>}
        </a>
      </section>
    )}

    <section>
      <div class="feed-header reveal">
        <h2>Derniers carnets</h2>
        <div class="filters" id="filters">
          <button data-filter="all" class="active">Tout</button>
          <button data-filter="contre-jour">Contre-jour</button>
          <button data-filter="hors-piste">Hors-piste</button>
          <button data-filter="contrebande">Contrebande</button>
        </div>
      </div>
      <div class="stagger">
        {autres.map((entry, i) => <ArticleCard entry={entry} index={i} />)}
      </div>
    </section>

    <section class="about reveal">
      <div class="about-eyebrow">À propos</div>
      <p>Trente ans à observer comment les organisations décident sous pression. En parallèle&nbsp;: un roman qui pose la même question autrement, et les outils qu'il faut construire soi-même quand la pensée ne suit pas les rails prévus pour elle.</p>
    </section>

    <Footer />
  </div>
</BaseLayout>

<style>
  .fondation {
    margin: 3rem 0 4rem;
    padding: 2rem;
    background: #F5F2EB;
    border-left: 3px solid #C8A97E;
    border-radius: 4px;
    max-width: 720px;
  }
  .fondation-badge {
    display: inline-block;
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #C8A97E;
    margin-bottom: 1rem;
  }
  .fondation-card {
    text-decoration: none;
    color: inherit;
  }
  .fondation-card .entry-title {
    font-family: var(--font-serif);
    font-size: 1.75rem;
    font-weight: 500;
    line-height: 1.3;
    margin: 0.5rem 0 0.75rem;
    color: #2B4257;
  }
  .fondation-card .entry-meta {
    font-family: var(--font-sans);
    font-size: 0.8rem;
    color: #8C6A3F;
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .fondation-card .entry-teaser {
    font-family: var(--font-sans);
    font-size: 1rem;
    line-height: 1.6;
    color: #4A4A4A;
    margin: 0;
  }
</style>
