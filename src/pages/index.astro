---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
import Pillars from '../components/Pillars.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { CATEGORIES, SITE } from '../consts';

const carnets = (await getCollection('carnets')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);

// L'article fondateur est retiré du flux chronologique et affiché en haut
const fondation = carnets.find((e) => e.id === 'planter-tailler-vendanger');
const autres = carnets.filter((e) => e.id !== 'planter-tailler-vendanger');

const personSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "name": SITE.name,
      "url": SITE.url,
      "description": SITE.description,
    },
    {
      "@type": "Person",
      "name": SITE.author,
      "url": SITE.url,
    },
  ],
};
---
<BaseLayout jsonLd={personSchema}>
  <div class="wrap">
    <Header />
  </div>

  <main>
    <div class="wrap">
      <section class="hero-intro">
        <div class="eyebrow wave-in">{SITE.eyebrow}</div>
        <h1 class="wave-in">{SITE.tagline} <em>roman</em> éclaire de nouveaux possibles.</h1>
        <p class="lede wave-in">{SITE.lede}</p>
      </section>

      {/* Arbre + Article fondateur côte à côte */}
      <section class="hero-fondation reveal">
        <figure class="hero-figure">
          <picture>
            <source srcset="/img/arbre.webp" type="image/webp">
            <img class="hero-tree" src="/img/arbre.png" alt="Arbre-réseau : un chêne dont les branches se dissolvent en dendrites neuronales" width="560" height="420" loading="eager" fetchpriority="high">
          </picture>
        </figure>
        {fondation && (
          <div class="fondation-content">
            <div class="fondation-badge">Article fondateur</div>
            <a class={`entry tag-${fondation.data.category}`} href={`/carnets/${fondation.id}/`}>
              <div class="entry-meta">
                <span>{CATEGORIES[fondation.data.category].label}</span>
                <span>·</span>
                <span>{fondation.data.date.toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' })}</span>
                <span>·</span>
                <span>{Math.max(1, Math.ceil((fondation.body?.split(/\s+/).length ?? 0) / 200))} min</span>
              </div>
              <h2 class="entry-title">{fondation.data.title}</h2>
              {fondation.data.teaser && <p class="entry-teaser">{fondation.data.teaser}</p>}
            </a>
          </div>
        )}
      </section>

      <Pillars />

      <section>
        <div class="feed-header reveal">
          <h2>Derniers carnets</h2>
          <div class="filters" id="filters">
            <button data-filter="all" class="active">Tout</button>
            <button data-filter="contre-jour">Contre-jour</button>
            <button data-filter="hors-piste">Hors-piste</button>
            <button data-filter="contrebande">Contrebande</button>
          </div>
        </div>
        <div class="stagger">
          {autres.map((entry, i) => <ArticleCard entry={entry} index={i} />)}
        </div>
      </section>

      <section class="about reveal">
        <div class="about-eyebrow">À propos</div>
        <p>Trente ans à observer comment les organisations décident sous pression. En parallèle&nbsp;: un roman qui pose la même question autrement, et les outils qu'il faut construire soi-même quand la pensée ne suit pas les rails prévus pour elle.</p>
      </section>
    </div>
  </main>

  <div class="wrap">
    <Footer />
  </div>
</BaseLayout>

<style>
  .hero-intro {
    margin-bottom: 3rem;
  }
  .hero-fondation {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: start;
    margin: 0 0 4rem;
    padding: 2.5rem;
    background: #F5F2EB;
    border-left: 3px solid #C8A97E;
    border-radius: 4px;
  }
  .hero-fondation .hero-figure {
    margin: 0;
    text-align: center;
  }
  .hero-fondation .hero-tree {
    max-width: 100%;
    height: auto;
  }
  .fondation-content {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .fondation-badge {
    display: inline-block;
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #C8A97E;
  }
  .fondation-content a {
    text-decoration: none;
    color: inherit;
  }
  .fondation-content .entry-title {
    font-family: var(--font-serif);
    font-size: 1.6rem;
    font-weight: 500;
    line-height: 1.3;
    margin: 0.25rem 0 0.75rem;
    color: #2B4257;
  }
  .fondation-content .entry-meta {
    font-family: var(--font-sans);
    font-size: 0.8rem;
    color: #8C6A3F;
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .fondation-content .entry-teaser {
    font-family: var(--font-sans);
    font-size: 1rem;
    line-height: 1.6;
    color: #4A4A4A;
    margin: 0;
  }
  @media (max-width: 800px) {
    .hero-fondation {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }
</style>
